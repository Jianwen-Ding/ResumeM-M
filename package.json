{
  "name": "resumem-m",
  "version": "0.1.0",
  "private": true,
  "description": "YAML-backed resume store with per-bullet variants, Jake's-format rendering, strict one-page PDFs, and application tracking.",
  "type": "module",
  "bin": {
    "rmm": "./bin/rmm.js"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "serve": "tsx src/server/index.ts",
    "rmm": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "mac:build": "python3 macos/build.py",
    "mac:install": "python3 macos/build.py --install",
    "mac:smoke": "node macos/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:editor": "node tests/editor.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "express": "^4.21.2",
    "marked": "^18.0.13",
    "pdfjs-dist": "^4.10.38",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
